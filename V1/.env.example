# Copy to backend/.env (or export in your shell). Never commit real values.

# ---- LLM provider -------------------------------------------------------
# gemini | none   ("none" disables generation; the assistant then returns
# retrieved evidence only and the UI labels the response accordingly)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=40

# ---- Embeddings / vector store ------------------------------------------
# Any sentence-transformers model id. Multilingual models are required for
# Hindi / Hinglish queries against the English-heavy knowledge base.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Local embedded Qdrant (no server needed). Set QDRANT_URL to use a server.
QDRANT_PATH=./data/runtime/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sakhisahay_knowledge

# ---- Retrieval behaviour -------------------------------------------------
RETRIEVAL_TOP_K=6
# Cosine-similarity gates below which evidence is treated as insufficient.
# e5 scores are compressed (~0.75-0.93) and Hindi/Hinglish queries score lower
# against English passages; values calibrated on backend/evaluation/eval_questions.yaml.
RETRIEVAL_MIN_SCORE=0.83
RETRIEVAL_MIN_SCORE_HI=0.78
RETRIEVAL_MIN_SCORE_HINGLISH=0.80

# ---- Relational database -------------------------------------------------
# SQLite for the local MVP. PostgreSQL URL for later phases, e.g.
# postgresql+psycopg://user:pass@localhost:5432/sakhisahay
DATABASE_URL=sqlite:///./data/runtime/sakhisahay.db

# ---- App ------------------------------------------------------------------
APP_ENV=development
# local = single local user, no login (MVP). jwt = planned for Phase 2.
AUTH_MODE=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
