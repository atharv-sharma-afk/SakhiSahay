*.db
*.sqlite3

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
pnpm-debug.log*

# Model caches and large artefacts
.cache/
models/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Screenshots are kept in docs/screenshots only
*.webm
