# ─────────────────────────────────────────────────────────────────────────────
# SakhiSahay RAG Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Google Gemini API key (get one free at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini model to use for answer generation
GEMINI_MODEL=gemini-1.5-flash

# ── Embedding Model ───────────────────────────────────────────────────────────
# HuggingFace sentence-transformers model (downloaded locally, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Qdrant Vector Store ───────────────────────────────────────────────────────
# Use LOCAL mode (file-based, no Docker required) or set QDRANT_URL for server mode.
# For local mode, leave QDRANT_URL empty and set QDRANT_LOCAL_PATH.
QDRANT_URL=
QDRANT_API_KEY=

# Path to local Qdrant storage directory (used when QDRANT_URL is empty)
QDRANT_LOCAL_PATH=./qdrant_storage

# Name of the Qdrant collection that stores document chunks
QDRANT_COLLECTION=sakhisahay_knowledge

# ── Retrieval Settings ────────────────────────────────────────────────────────
# Number of top chunks to retrieve per query
RETRIEVAL_TOP_K=5

# Minimum cosine similarity score to accept a chunk (0.0–1.0)
# Set to 0.0 to disable filtering (useful during development)
RETRIEVAL_SCORE_THRESHOLD=0.35

# ── Chunking Settings ─────────────────────────────────────────────────────────
# Target chunk size in tokens (approximate; based on words ÷ 0.75)
CHUNK_SIZE_TOKENS=800

# Token overlap between consecutive chunks
CHUNK_OVERLAP_TOKENS=120

# ── API Settings ──────────────────────────────────────────────────────────────
# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins (frontend URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum characters allowed in a single user message
MAX_MESSAGE_LENGTH=2000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
